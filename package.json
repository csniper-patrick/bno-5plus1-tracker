{
  "name": "bno-5plus1-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite-ssg build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js && LANG=en_GB.UTF-8 LC_ALL=en_GB.UTF-8 LC_TIME=en_GB.UTF-8 playwright test",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e": "LANG=en_GB.UTF-8 LC_ALL=en_GB.UTF-8 LC_TIME=en_GB.UTF-8 playwright test",
    "test:e2e:ui": "LANG=en_GB.UTF-8 LC_ALL=en_GB.UTF-8 LC_TIME=en_GB.UTF-8 playwright test --ui",
    "capture:screenshots": "LANG=en_GB.UTF-8 LC_ALL=en_GB.UTF-8 LC_TIME=en_GB.UTF-8 CAPTURE_SCREENSHOTS=true playwright test e2e/generate-instruction-screenshots.spec.js",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "jszip": "^3.10.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "fake-indexeddb": "^6.2.7",
    "prettier": "3.9.10",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vite-ssg": "^28.3.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
